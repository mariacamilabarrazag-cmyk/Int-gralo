# ======== Integralo: configuración de la PLATAFORMA ========
# (La configuración de cada tienda —marca, asistente, WhatsApp, Instagram…— se hace desde el panel.)

# Dirección pública donde corre Integralo (con https en producción)
PUBLIC_URL=http://localhost:8000
# Solo para el servidor con deploy/docker-compose.yml: el dominio sin https:// (ej. heymap.duckdns.org)
DOMAIN=

# Clave para cifrar credenciales y firmar sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ¡No la cambies después o se perderán las credenciales guardadas!
SECRET_KEY=

# true = cualquiera puede crear una cuenta para su tienda en /registro
# false = solo tú creas tiendas con: python -m scripts.crear_tienda ...
ALLOW_SIGNUP=true

# IA (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Tiendanube — app de Integralo en el Portal de Socios (https://partners.tiendanube.com)
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
# Contacto que Tiendanube exige en el User-Agent
TIENDANUBE_USER_AGENT=Integralo (tu-correo-de-soporte@ejemplo.com)

# Opcional
# DATA_DIR=/ruta/a/datos
# GRAPH_VERSION=v21.0
